# 값은 비워 두고, 실제 값은 .env(로컬) 또는 GitHub Secrets(배포)에 넣는다.
# 이 파일에는 절대 실제 키를 적지 않는다.

# --- 상담문의 폼 (Web3Forms) ---
# https://web3forms.com 에서 수신 이메일로 발급받은 access key (공개용 키)
WEB3FORMS_ACCESS_KEY=
# 상담 접수 메일을 받을 주소 — Web3Forms 키를 발급받은 이메일과 같아야 한다.
# (수신 주소는 키에 묶여 있어 코드로 전달되지 않음. 기록·인수인계용)
CONTACT_EMAIL=

# --- 2차: Supabase (회원·게시판) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
